# Server-only configuration. No NEXT_PUBLIC credentials.
PROVIDER_API_URL=https://your-api.example.com/api/v1/provider/
PROVIDER_DASHBOARD_ORIGIN=https://your-staging-dashboard.example.com
# Generate using: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
PROVIDER_SESSION_SECRET=
# Admin sessions use a distinct key and cookie. Generate another random 32-byte hex key.
ADMIN_SESSION_SECRET=
# Optional: defaults to the admin sibling of PROVIDER_API_URL and the provider origin.
ADMIN_API_URL=
ADMIN_DASHBOARD_ORIGIN=
